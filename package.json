{
  "name": "mobile-automation-demo",
  "version": "1.0.0",
  "description": "Cross-platform (Android + iOS) mobile test automation framework - WebdriverIO, Appium, Mocha, TypeScript, Allure",
  "private": true,
  "scripts": {
    "appium": "appium --base-path / --port 4723",
    "test:android": "cross-env PLATFORM=android wdio run ./wdio.conf.ts",
    "test:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.ts",
    "test:android:bs": "cross-env ENV=browserstack PLATFORM=android wdio run ./wdio.conf.ts",
    "test:ios:bs": "cross-env ENV=browserstack PLATFORM=ios wdio run ./wdio.conf.ts",
    "report": "allure serve allure-results",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/allure-reporter": "9.27",
    "@wdio/cli": "9.27",
    "@wdio/globals": "9.27",
    "@wdio/local-runner": "9.27",
    "@wdio/mocha-framework": "9.27",
    "@wdio/spec-reporter": "9.27",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.16.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.3",
    "webdriverio": "9.27"
  }
}
